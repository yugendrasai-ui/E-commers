:root {
    --primary-color: #224abe;
    --secondary-color: #858796;
    --success-color: #1cc88a;
    --info-color: #36b9cc;
    --warning-color: #f6c23e;
    --danger-color: #e74a3b;
    --sidebar-bg: #1a1c23;
    --sidebar-hover: #2e313c;
    --body-bg: #f8f9fc;
    --card-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
}

/* Global Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Poppins', 'Segoe UI', sans-serif;
    background-color: var(--body-bg);
    color: #333;
    line-height: 1.5;
}

/* Sidebar */
.sidebar {
    width: 250px;
    background-color: var(--sidebar-bg);
    color: white;
    padding: 1.5rem 0;
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    overflow-y: auto;
    z-index: 1000;
    padding-bottom: 2rem;
    transition: left 0.3s ease;
}

.main-content {
    margin-left: 250px;
    padding: 2rem;
    min-height: 100vh;
    transition: margin-left 0.3s ease, padding 0.3s ease;
    background-color: var(--body-bg);
    width: auto;
}

/* Sidebar Brand */
.sidebar-brand {
    padding: 0 1.5rem 1.5rem;
    display: flex;
    align-items: center;
    font-size: 1.25rem;
    font-weight: 700;
    color: white;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 1.5rem;
}

.sidebar-brand i {
    margin-right: 0.75rem;
    font-size: 1.5rem;
    color: #f6c23e;
}

/* Sidebar Nav Items */
.nav-item {
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: all 0.2s;
    font-size: 14px;
}

.nav-item:hover,
.nav-item.active {
    color: white;
    background-color: var(--sidebar-hover);
}

.nav-item.active {
    font-weight: 600;
    border-left: 4px solid var(--warning-color);
}

.nav-item i {
    margin-right: 0.75rem;
    width: 20px;
    text-align: center;
}

.nav-heading {
    padding: 1.5rem 1.5rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 1px;
}

/* Mobile Top Bar */
.admin-mobile-bar {
    display: none;
    position: sticky;
    top: 0;
    z-index: 900;
    background: #1a1c23;
    padding: 12px 16px;
    align-items: center;
    gap: 14px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

.admin-hamburger {
    background: none;
    border: none;
    color: #fff;
    font-size: 22px;
    cursor: pointer;
    padding: 4px 8px;
}

.admin-mobile-title {
    color: #fff;
    font-weight: 700;
    font-size: 16px;
}

.admin-sidebar-close {
    display: none;
    position: absolute;
    top: 14px;
    right: 14px;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    font-size: 28px;
    cursor: pointer;
    z-index: 1001;
}

.admin-sidebar-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 998;
}

/* Table Card */
.table-card {
    background: white;
    border-radius: 0.75rem;
    box-shadow: var(--card-shadow);
    overflow: hidden;
    margin-top: 1.5rem;
}

.table-responsive {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    display: block;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th {
    text-align: left;
    padding: 1rem 1.5rem;
    background: #f8f9fc;
    color: #4e73df;
    font-weight: 700;
    font-size: 0.85rem;
    border-bottom: 2px solid #e3e6f0;
}

td {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #e3e6f0;
    color: #5a5c69;
    font-size: 0.9rem;
}

/* Status Pills */
.status-pill {
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
    font-size: 0.75rem;
    font-weight: 700;
}

.status-active {
    background: #d1e7dd;
    color: #0f5132;
}

.status-blocked {
    background: #f8d7da;
    color: #842029;
}

.status-pending {
    background: #fff3cd;
    color: #664d03;
}

/* Buttons */
.btn-action {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    border-radius: 0.25rem;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    margin-right: 0.5rem;
    transition: 0.2s;
}

.btn-block {
    background: #e74a3b;
    color: white;
}

.btn-unblock {
    background: #1cc88a;
    color: white;
}

.btn-approve {
    background: #4e73df;
    color: white;
}

.btn-history {
    background: #36b9cc;
    color: white;
}

